# Database (SQLite for local dev; portable to Postgres for production)
# NOTE: path is relative to prisma/schema.prisma, so ../db/custom.db points
# to <project-root>/db/custom.db. This works on Windows, macOS, and Linux.
DATABASE_URL=file:../db/custom.db

# NextAuth.js — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-your-secret

# NextAuth URL — the app's base URL
NEXTAUTH_URL=http://localhost:3000

# --- Market data sources (all optional — defaults work with zero config) ---

# CoinGecko (aggregator reference prices). Free tier needs no key.
# Set this if CoinGecko requires a demo key (rate-limit bumps).
# COINGECKO_API_KEY=

# CCXT exchange for executable marks + OHLCV. Default: bybit.
# Alternatives: okx, binance, kraken, coinbase, kucoin.
# CCXT_EXCHANGE=bybit
# CCXT_API_KEY=        # only if you hit rate limits on public endpoints
# CCXT_API_SECRET=

# Flare FTSO on-chain oracle (canonical FLR/USD price + cross-check).
# Default: Flare mainnet public RPC. No key needed.
# FLARE_RPC_URL=https://flare-api.flare.network/ext/C/rpc
